{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "jsx": "react-jsx"
  },
  "include": [
    "server/**/*.ts",
    "shared/**/*.ts",
    "tests/**/*.ts",
    "web/**/*.ts",
    "web/**/*.tsx"
  ]
}
